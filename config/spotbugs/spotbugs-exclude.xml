<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtros de SpotBugs para el proyecto TicketFlow.

  SPRING_ENDPOINT: alerta informativa que marca cualquier clase
  anotada con @RestController/@Controller como "endpoint alcanzable
  remotamente". No es un defecto: en este proyecto los Controllers
  son la interfaz pública intencional, así que se ignora.

  EI_EXPOSE_REP2 (scope RedisSeatLockService): alerta que se dispara
  cuando un constructor almacena en un campo una referencia a un
  objeto recibido por parámetro. Para el caso concreto del
  RedisTemplate inyectado en RedisSeatLockService es un falso
  positivo: Spring garantiza que el bean es un singleton seguro para
  hilos, por lo que almacenar la referencia no expone representación
  interna mutable. El filtro se limita a esta clase (no al proyecto
  entero) para no silenciar defectos reales que puedan aparecer en
  otros servicios que reciban tipos verdaderamente mutables.

  EI_EXPOSE_REP2 (scope KafkaReservaConfirmadaPublisher): mismo caso
  que el anterior, pero aplicado al KafkaTemplate inyectado en el
  publicador de reservas. El KafkaTemplate es un bean de Spring con
  ámbito singleton y, por diseño de spring-kafka, seguro para hilos;
  almacenar su referencia por inyección por constructor no expone
  representación interna mutable alguna.
-->
<FindBugsFilter>
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.ticketflow.reservation.lock.RedisSeatLockService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.ticketflow.reservation.mensajeria.KafkaReservaConfirmadaPublisher"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
